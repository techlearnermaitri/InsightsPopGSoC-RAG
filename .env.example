# Backend API Configuration
# Copy this file to .env and fill in your actual values for local development
# For Render deployment, add these as environment variables in the Render dashboard

# ===== REQUIRED =====
# Pinecone Vector Database API Key
# Get it from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Groq LLM API Key (for using Llama models)
# Get it from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ===== OPTIONAL =====
# Email configuration (for OTP verification emails via Gmail)
# Only needed if you want to enable email-based authentication
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Embedding Model (defaults to all-mpnet-base-v2 if not set)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Embedding Dimension (defaults to 768 if not set)
EMBEDDING_DIM=768

# Groq Model Name (defaults to llama-3.3-70b-versatile if not set)
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Pinecone Index Name (defaults to insights-pop if not set)
PINECONE_INDEX_NAME=insights-pop
